# Endpoints and keys. Only the ones for the systems you run are needed.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
TOKENWAVE_BASE_URL=          # OpenAI-compatible endpoint for the GPT / Grok systems
TOKENWAVE_API_KEY=
TOKENWAVE_GROK_KEY=
TOKENWAVE_GEMINI_KEY=
ZGC_BASE_URL=                # OpenAI-compatible gateway for Kimi, GLM, DeepSeek, Qwen and the Gemini judge
ZGC_API_KEY=
ALIYUN_BASE_URL=             # optional second gateway (e.g. for DeepSeek-V4.1 Flash)
ALIYUN_API_KEY=
HC_BASE_URL=
HC_API_KEY=
MOSS_API_ORIGIN=
MOSS_API_KEY=
VMB_PROXY=                   # optional outbound proxy for the sandbox (web, pip, model downloads)
VMB_CPUS=6
VMB_MEM=24g
